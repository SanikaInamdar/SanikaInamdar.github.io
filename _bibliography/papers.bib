@inproceedings{doshi-etal-2024-distributed-mqtt,
  abbr={IEEE ESCI},
  title={Distributed MQTT Broker: A Load-Balanced Redis-Based Architecture},
  author={Doshi, Rohan and Inamdar, Sanika and Karmarkar, Tanmay and Wakode, Madhuri},
  booktitle={2024 International Conference on Emerging Smart Computing and Informatics (ESCI)},
  year={2024},
  month=mar,
  address={Pune, India},
  publisher={IEEE},
  doi={10.1109/ESCI59607.2024.10497427},
  abstract={The Internet of Things (IoT) has revolutionized data transfer in industries through the MQTT protocol, a lightweight publish-subscribe messaging protocol. Traditional MQTT brokers are single-node setups, while distributed brokers offer scalability, redundancy, load balancing and fault tolerance for large-scale IoT deployments. The proposed Load-Balancer Redis-based architecture for distributed MQTT brokers overcomes the shortcomings of traditional brokers: the Load-Balancer transfers all incoming TCP packets to the brokers for processing, ensuring equal utilization of each broker node, and Redis acts as a synchronization layer for the brokers where state information is stored.},
  html={https://ieeexplore.ieee.org/document/10497427},
  preview={mqtt-broker.png},
  selected={true}
}

